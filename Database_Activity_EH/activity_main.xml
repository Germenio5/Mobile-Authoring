<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="STUDENTS RECORDS"
            android:textColor="#163A70"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="Manage your student information"
            android:textColor="#718096"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="STUDENT DETAILS"
            android:textColor="#2457A6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editstudentId"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:hint="Student ID"
            android:inputType="number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#24364B"
            android:textColorHint="#8998AC"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:hint="Full Name"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#24364B"
            android:textColorHint="#8998AC"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/editCourse"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:hint="Course"
            android:inputType="textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#24364B"
            android:textColorHint="#8998AC"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/editYearLevel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:hint="Year Level"
            android:inputType="number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#24364B"
            android:textColorHint="#8998AC"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnView"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E2ECFF"
                android:elevation="0dp"
                android:text="View"
                android:textAllCaps="false"
                android:textColor="#2457A6"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#2563EB"
                android:elevation="0dp"
                android:text="Insert"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#FDEBEC"
                android:elevation="0dp"
                android:text="Delete"
                android:textAllCaps="false"
                android:textColor="#B42335"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#2563EB"
                android:elevation="0dp"
                android:text="Update"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="RESULTS"
            android:textColor="#2457A6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRecords"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:minHeight="130dp"
            android:background="@drawable/bg_records"
            android:gravity="top|start"
            android:padding="16dp"
            android:text="Student records and server responses will appear here."
            android:textColor="#334155"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:scrollbars="vertical"
            android:overScrollMode="ifContentScrolls" />

    </LinearLayout>

</ScrollView>
